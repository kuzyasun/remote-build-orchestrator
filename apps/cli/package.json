{
  "name": "@gemslibe/rbo",
  "version": "0.7.0",
  "description": "Run isolated build, test, QEMU, and Docker jobs on local or remote workers from AI coding clients over MCP.",
  "keywords": [
    "remote-build",
    "build-orchestration",
    "distributed-build",
    "model-context-protocol",
    "mcp",
    "ai-coding-assistant",
    "developer-tools",
    "qemu",
    "docker"
  ],
  "license": "AGPL-3.0-only",
  "author": {
    "name": "Serge Martyniuk",
    "email": "smdev42@proton.me"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kuzyasun/remote-build-orchestrator.git",
    "directory": "apps/cli"
  },
  "bugs": {
    "url": "https://github.com/kuzyasun/remote-build-orchestrator/issues"
  },
  "homepage": "https://github.com/kuzyasun/remote-build-orchestrator#readme",
  "type": "module",
  "main": "./dist/rbo.js",
  "bin": {
    "rbo": "./dist/rbo.js",
    "rbo-mcp-stdio": "./dist/rbo-mcp-stdio.js"
  },
  "files": [
    "dist/rbo.js",
    "dist/rbo-mcp-stdio.js",
    "config/controller.json",
    "config/agent.json",
    "scripts/stop-running-rbo.mjs",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24.0"
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "typecheck": "tsc --noEmit",
    "preinstall": "node ./scripts/stop-running-rbo.mjs",
    "preuninstall": "node ./scripts/stop-running-rbo.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^13.0.1",
    "selfsigned": "^5.5.0",
    "ulid": "^2.3.0",
    "ws": "^8.21.1",
    "zod": "^3.24.2"
  },
  "optionalDependencies": {
    "@gemslibe/rbo-windows-executor-win32-x64": "workspace:0.7.0"
  },
  "devDependencies": {
    "@rbo/agent": "workspace:*",
    "@rbo/controller": "workspace:*",
    "@rbo/executor": "workspace:*",
    "@rbo/protocol": "workspace:*",
    "@rbo/shared": "workspace:*",
    "@types/node": "^22.13.4",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.3"
  }
}
